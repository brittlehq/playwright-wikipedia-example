# Copy this file to .env and fill in real values.
# .env is gitignored — never commit a real token.

# Brittle hub to report results to.
#   Local dev:   http://localhost:3100
#   Public demo: https://app.brittle.dev
BRITTLE_URL=http://localhost:3100

# Service token for the project. Mint one under:
#   Manage → Projects → [your project] → Tokens → New token → type: service
BRITTLE_TOKEN=

# Optional — branch label shown on the Runs page. Defaults to "main".
# BRITTLE_BRANCH=main

# Optional — human-readable run name. Defaults to "Wikipedia · YYYY-MM-DD".
# Parallel browser workers sharing the same name collapse into one Run.
# BRITTLE_RUN_NAME=Wikipedia smoke · local

# Optional — comma-separated run-level tags.
# BRITTLE_RUN_TAGS=nightly,wikipedia
