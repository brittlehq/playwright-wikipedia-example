# Copy this file to .env.local and fill in real values. The .env file is
# .gitignore'd at the repo root; never commit a real token.

# Brittle hub the reporter will post results to.
#   - Local dev: http://localhost:3100
#   - Public demo: https://brittle.dev
BRITTLE_URL=http://localhost:3100

# Token for your Brittle project. Mint one under:
#   Project → Settings → Tokens → "New token" → type "service" (for CI) or "personal" (for laptops)
BRITTLE_TOKEN=brt_svc_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Override the run name shown on the dashboard.
# Defaults to a generated `jest-local-<timestamp>` string.
# CI_BUILD_ID=jest-ci-1234
